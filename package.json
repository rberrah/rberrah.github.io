{
	"name": "pharmacometrie-explain",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"predev": "node scripts/generate_tdm_catalog.mjs",
		"dev": "vite dev",
		"prebuild": "node scripts/generate_tdm_catalog.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"precheck": "node scripts/generate_tdm_catalog.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"validate": "node scripts/validate_content.mjs",
		"smoke": "node scripts/smoke_test.mjs",
		"test": "node scripts/validate_content.mjs && node scripts/smoke_test.mjs",
		"test:e2e": "playwright test",
		"slides:index": "node scripts/generate_slide_index.mjs",
		"slides:catalog": "node scripts/sync_slide_catalog.mjs",
		"slides:export": "bash scripts/export_pptx_png.sh",
		"tdm:index": "node scripts/generate_tdm_catalog.mjs",
		"tdm:run": "Rscript tdm-engine/run_local.R",
		"tdm:test": "Rscript tdm-engine/tests/smoke_test.R",
		"tdm:test-lego": "Rscript tdm-engine/tests/safe_lego_test.R",
		"tdm:validate-library": "Rscript tdm-engine/tests/validate_library.R"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource-variable/source-serif-4": "^5.2.9",
		"@sveltejs/adapter-static": "^3.0.10",
		"d3": "^7.9.0",
		"d3-scale": "^4.0.2",
		"d3-selection": "^3.0.0",
		"d3-shape": "^3.2.0",
		"gray-matter": "^4.0.3",
		"js-yaml": "^4.1.0",
		"katex": "^0.16.28",
		"layercake": "^10.0.2",
		"markdown-it": "^14.1.0",
		"svelte-scroller": "^1.2.2",
		"zod": "^3.23.8"
	}
}

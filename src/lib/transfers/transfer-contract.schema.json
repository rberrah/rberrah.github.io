{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rberrah.github.io/pharmacometrie/schemas/transfer-contract-v3.json",
  "title": "PMx Explain transfer contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "destination",
    "transferredFields",
    "units",
    "route",
    "compartment",
    "schedule",
    "omittedFields",
    "transformations",
    "limitations"
  ],
  "properties": {
    "version": { "const": 3 },
    "source": { "type": "string", "minLength": 1 },
    "destination": { "type": "string", "minLength": 1 },
    "transferredFields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "units": { "type": "object", "additionalProperties": { "type": "string" } },
    "route": {},
    "compartment": {},
    "schedule": {},
    "omittedFields": { "type": "array", "items": { "type": "string" } },
    "transformations": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
